---
import { site, mailto, whatsapp, book } from '../site';

interface Props {
  heading?: string;
  text?: string;
  subject?: string;
}

const {
  heading = 'Book a free 20-minute infra or AI review.',
  text = "Bring your cloud bill, your deploy process, your audit deadline or your AI idea. You’ll leave with three concrete next steps, whether or not we work together.",
  subject = 'Free 20-minute review',
} = Astro.props;
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact-copy">
      <h2 id="contact-title">{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="contact-actions">
      <div class="contact-buttons">
        <a class="btn btn-light" href={book(subject)}>Book a 20-minute call →</a>
        <a class="btn btn-outline-light" href={whatsapp(`Hi Usama, I found you on usamaops.com. ${subject}:`)}>Message on WhatsApp</a>
        <a class="btn btn-outline-light" href={mailto(subject)}>Email me</a>
      </div>
      <div class="contact-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={whatsapp()}>WhatsApp {site.phoneDisplay}</a>
        <a href={site.linkedin}>LinkedIn</a>
        <a href={site.github}>GitHub</a>
      </div>
    </div>
  </div>
</section>
