---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import { site, mailto, whatsapp } from '../site';
import { servicePath } from '../data/services';
import { homeUrl, personNode, businessNode, faqNode } from '../lib/schema';

// Build facts for the "this site runs on" panel. Cloudflare Pages sets CF_PAGES_COMMIT_SHA at build time.
const sha = process.env.CF_PAGES_COMMIT_SHA || process.env.GITHUB_SHA || '';
const shortSha = sha ? sha.slice(0, 7) : 'local';
const commitUrl = sha ? `${site.repo}/commit/${sha}` : site.repo;
const builtAt = new Date();
const builtLabel = `${builtAt.toISOString().slice(0, 10)} ${builtAt.toISOString().slice(11, 16)} UTC`;

const title = 'Muhammad Usama — Freelance DevOps, SRE & AI Consultant';
const description =
  'Muhammad Usama (UsamaOps): freelance DevOps & SRE consultant for startups and established businesses. Cloud cost cuts, CI/CD, SOC 2 and AI integration.';

const problems = [
  {
    title: 'The cloud bill keeps climbing',
    body: "Idle resources, oversized instances, no commitments. Flexera’s 2026 survey puts wasted cloud spend at 29%.",
  },
  {
    title: 'Deploys feel risky',
    body: 'Manual steps, no rollback, and one person who knows how it all works.',
  },
  {
    title: 'Certificates expire and take you down',
    body: 'From March 15, 2027, public TLS certificates max out at 100 days. Manual renewal stops scaling.',
  },
  {
    title: 'An audit is coming',
    body: 'SOC 2, PCI DSS, ISO 27001 or HIPAA controls your compliance platform keeps flagging: IAM, MFA, logging, encryption, backups.',
  },
  {
    title: 'Customers find outages first',
    body: 'No dashboards, no alerts, no on-call runbook for the night something breaks.',
  },
  {
    title: 'AI is stuck in a demo, or costs too much',
    body: 'Pilots that never ship, token bills nobody forecast, and customer data sent to models without guardrails.',
  },
];

const packages = [
  {
    name: 'Cloud Cost Optimization',
    slug: 'cloud-cost-optimization',
    time: '1–2 weeks',
    price: '$1,200–2,000',
    min: 1200,
    max: 2000,
    body: 'Bill and usage analysis, rightsizing, commitments, storage and egress, idle resources. Quick wins implemented, not just listed.',
    guarantee:
      'At least 2× the fee in annualised savings, or no charge. For teams spending $3,000+ a month on cloud.',
  },
  {
    name: 'TLS Certificate Automation',
    slug: 'tls-certificate-automation',
    time: '1–2 weeks',
    price: '$2,000–4,000',
    min: 2000,
    max: 4000,
    body: 'Inventory every certificate, automate renewal with ACME and cert-manager, add expiry alerts and a rotation runbook. Ready for 100-day certificates.',
  },
  {
    name: 'CI/CD, Terraform & Kubernetes',
    slug: 'ci-cd-terraform-kubernetes',
    time: '2–4 weeks',
    price: '$3,000–6,000',
    min: 3000,
    max: 6000,
    body: 'Terraform modules, GitHub Actions pipelines, environments, secrets management and rollback your whole team can trust.',
  },
  {
    name: 'Compliance Readiness',
    slug: 'compliance-readiness',
    time: '2–4 weeks',
    price: '$3,000–8,000',
    min: 3000,
    max: 8000,
    body: 'SOC 2, PCI DSS, ISO 27001, HIPAA or GDPR: I fix the infrastructure controls your auditor or compliance platform flags, from IAM and MFA to logging, encryption, backups and access reviews.',
  },
];

const aiPackages = [
  {
    name: 'AI Opportunity & Cost Review',
    time: '3–5 days',
    price: '$750',
    min: 750,
    max: 750,
    body: 'I map your workflows, find the 3–5 tasks where AI saves real hours, estimate the monthly model cost of each, and pick models and vendors that meet your privacy needs. You get a costed build plan.',
  },
  {
    name: 'AI Workflow Automation',
    time: '1–3 weeks',
    price: '$1,500–4,000',
    min: 1500,
    max: 4000,
    body: 'One business process automated end to end: support triage, document and invoice processing, lead research or internal reporting. Human review where it matters, full logging and hard spend caps.',
  },
  {
    name: 'Production AI Integration',
    time: '2–4 weeks',
    price: '$3,000–8,000',
    min: 3000,
    max: 8000,
    body: 'LLM features shipped into your product safely: keys in a secrets manager, rate limits and per-customer spend caps, PII redaction, fallbacks across providers, evaluations, and cost and latency dashboards.',
  },
];

const aiCostLevers = [
  'Right-size the model: route simple tasks to small, cheap models and keep frontier models for the hard ones',
  'Cache prompts and responses, and batch work that is not urgent',
  'Hard budgets per feature and per customer, with alerts before the bill surprises you',
  'Self-host open-weight models only when your volume makes it cheaper',
  'Your data stays yours: no-retention API settings, PII redaction and audit logs',
];

const cases = [
  {
    kicker: 'Payments · PCI DSS scope',
    title: 'Emergency mTLS certificate rotation across ~30 microservices',
    problem:
      'A critical mTLS certificate expiry hit ~30 services at once, plus the wildcard certificate on the load balancer.',
    did: 'Rotated certificates across every affected service and the load balancer, and brought service-to-service traffic back up.',
    tags: ['mTLS', 'Kubernetes', 'Load balancer'],
  },
  {
    kicker: 'Payments · private network',
    title: 'CI/CD into private production with zero inbound access',
    problem: 'Production servers sit on private IPs, so push-based deploys meant opening the network.',
    did: 'Built pull-based GitHub Actions deploys: artifacts land in object storage, a serverless function triggers an on-host agent that pulls and deploys.',
    tags: ['GitHub Actions', 'Huawei Cloud', 'Serverless trigger'],
  },
  {
    kicker: 'Payments · card issuing',
    title: 'Encrypted card-file pipeline with a card-production bureau',
    problem: 'Card embossing files had to reach an external bureau with nothing exposed in transit.',
    did: "SFTP with PGP encryption to the bureau’s RSA key, plus IP allowlisting through the NAT gateway.",
    tags: ['SFTP', 'PGP', 'NAT allowlisting'],
  },
  {
    kicker: 'Payments · AI-assisted build',
    title: 'Automated, PAN-free reporting pipeline',
    problem: 'Card-network reports arrived encrypted over SFTP and needed pulling, decrypting and forwarding by hand.',
    did: 'A Node.js pipeline, built with Claude Code, that pulls, decrypts and emails the reports, verified to carry no card numbers.',
    tags: ['Node.js', 'SFTP + PGP', 'Claude Code'],
  },
];

const steps = [
  { name: 'Audit', body: 'Read-only access. I map what you run, what it costs and where it can fail.' },
  { name: 'Plan', body: 'A prioritised 30/60/90-day plan with a quote for each step.' },
  { name: 'Implement', body: 'Changes through code review and infrastructure as code, not console clicks.' },
  { name: 'Handover', body: 'Runbooks, diagrams and a walkthrough so your team runs it without me.' },
];

const faqs = [
  {
    q: 'How much does a freelance DevOps consultant cost?',
    a: 'You get a clear quote before any work starts, so you know the cost up front. The Infrastructure Health Check starts from $500. Projects run $750–8,000 depending on scope, and fractional DevOps/SRE support is $1,000–3,000 a month for 20–30 hours a week.',
  },
  {
    q: 'Can you reduce our AWS, Google Cloud or Oracle Cloud bill?',
    a: 'Yes. My cloud cost optimization work reviews usage, rightsizing, commitments, storage and egress on any of the major clouds, then implements the quick wins. For teams spending $3,000 or more a month on cloud, I guarantee at least twice the fee in annualised savings or you pay nothing.',
  },
  {
    q: 'Which cloud providers do you work with?',
    a: 'AWS, Google Cloud (GCP), Oracle Cloud (OCI) and Huawei Cloud, plus multi-cloud setups that combine them. The tooling I build with, such as Terraform, Kubernetes and GitHub Actions, works the same way across all of them.',
  },
  {
    q: 'Do you only work with startups?',
    a: 'No. I work with startups, SaaS companies and established businesses, from a first deployment pipeline to cost, security and compliance work on systems that have run for years. Most clients have no dedicated DevOps or SRE team, or need senior hands for one project.',
  },
  {
    q: 'Do you help companies get ready for SOC 2, PCI DSS, ISO 27001 or HIPAA?',
    a: 'Yes. I run PCI DSS-scoped payment infrastructure in production, and I fix the infrastructure controls auditors and compliance platforms check for SOC 2, PCI DSS, ISO 27001, HIPAA and GDPR: IAM, MFA, logging, encryption, backups and access reviews. I don’t issue audit reports; I get your infrastructure ready for your auditor.',
  },
  {
    q: 'How do you keep AI costs low in production?',
    a: 'By sending each task to the cheapest model that does it well, caching prompts and responses, batching work that isn’t urgent, and putting hard spend limits on every feature and customer. Self-hosting open-weight models only makes sense at high volume, and I’ll tell you when it does.',
  },
  {
    q: 'Can you integrate AI into our existing product or business workflows?',
    a: 'Yes. I can automate a single workflow, such as support triage or document processing, or ship LLM features into your product behind your existing authentication, logging and monitoring, with privacy controls and cost dashboards from day one.',
  },
  {
    q: 'Can I hire you as a remote DevOps engineer?',
    a: 'Yes. I work remotely from Lahore, Pakistan, on projects or a monthly fractional DevOps/SRE retainer, invoiced in USD. You get a senior engineer without the cost of a full-time hire.',
  },
  {
    q: 'Which time zones do you work with?',
    a: 'I’m in Lahore, Pakistan (UTC+5). That overlaps US East Coast mornings, most of the UK and European working day, and the full Gulf working day.',
  },
  {
    q: 'How do we get started?',
    a: `Email ${site.email} to book a free 20-minute call. If there’s a fit, the Health Check or AI Review starts with read-only access, usually within a week.`,
  },
];

const allOffers = [
  { name: 'Infrastructure Health Check', min: 500 },
  ...packages,
  ...aiPackages,
  { name: 'Fractional DevOps Engineer (monthly)', min: 1000, max: 3000 },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${homeUrl}#website`,
    url: homeUrl,
    name: site.brand,
    alternateName: [site.name, 'usamaops.com'],
    inLanguage: 'en',
    publisher: { '@id': personNode['@id'] },
  },
  personNode,
  businessNode(description, allOffers),
  faqNode(faqs),
];

const check = 'M4 10.5l4 4 8-9';
const aboutMeta = ['BSc Computer Science, GC University Lahore', 'AWS', 'Google Cloud', 'Oracle Cloud', 'Huawei Cloud', 'Multi-cloud', 'Kubernetes', 'Terraform', 'Ansible'];
---

<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Header />

  <main id="main">
    <section class="container hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Freelance DevOps, SRE &amp; AI consultant · Remote from Lahore, Pakistan</p>
        <h1 id="hero-title">I make your cloud infrastructure secure, compliant and cheaper to run.</h1>
        <p class="hero-lead">
          Senior DevOps/SRE for startups, SaaS teams and established businesses, on AWS, Google Cloud, Oracle Cloud,
          Huawei Cloud and multi-cloud setups. By day I run PCI DSS payment infrastructure in production with
          Kubernetes and Terraform. I also help companies put AI to work without runaway costs. A clear quote before
          work starts, not open-ended hours.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={mailto('Free 20-minute infra review')}>Book a free 20-min infra review</a>
          <a class="btn btn-secondary" href="#services">See the packages →</a>
        </div>
        <p class="hero-note">
          Overlaps US East Coast mornings and UK, European and Gulf business hours. Prefer chat?{' '}
          <a href={whatsapp('Hi Usama, I found you on usamaops.com.')}>Message me on WhatsApp</a>.
        </p>
      </div>

      <section class="infra-panel" aria-label="How this site is built and deployed">
        <div class="infra-head">
          <span>usamaops.com / production</span>
          <span class="infra-status"><span class="infra-dot" aria-hidden="true"></span>deployed</span>
        </div>
        <dl class="infra-list">
          <dt>last_deploy</dt>
          <dd><time datetime={builtAt.toISOString()}>{builtLabel}</time></dd>
          <dt>commit</dt>
          <dd><a href={commitUrl}>{shortSha}</a></dd>
          <dt>hosting</dt>
          <dd>Cloudflare Pages · $0 / mo</dd>
          <dt>tls</dt>
          <dd>Universal SSL · auto-renewed</dd>
          <dt>headers</dt>
          <dd>CSP · HSTS · nosniff</dd>
        </dl>
        <div class="infra-foot">
          <div>git push → CI checks → build → global CDN</div>
          <div>No client-side JavaScript. No trackers.</div>
          <a href={site.repo}>View the source →</a>
        </div>
      </section>
    </section>

    <section class="trust" aria-label="Hands-on experience">
      <div class="container">
        <span class="trust-label">Platforms &amp; frameworks I work with</span>
        <span class="trust-item">AWS</span>
        <span class="trust-item">Google Cloud</span>
        <span class="trust-item">Oracle Cloud</span>
        <span class="trust-item">Huawei Cloud</span>
        <span class="trust-item">Multi-cloud</span>
        <span class="trust-item">PCI DSS</span>
        <span class="trust-item">ISO 27001</span>
        <span class="trust-item">Kubernetes</span>
        <span class="trust-item">Terraform</span>
        <span class="trust-item">Ansible</span>
        <span class="trust-item">GitHub Actions</span>
      </div>
    </section>

    <section class="container section" id="problems" aria-labelledby="problems-title">
      <p class="eyebrow">Problems I fix</p>
      <h2 class="section-title" id="problems-title">If one of these is on your plate this quarter, we should talk.</h2>
      <div class="grid grid-3">
        {
          problems.map((p, i) => (
            <div class="card">
              <div class="card-num">{String(i + 1).padStart(2, '0')}</div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))
        }
        <a class="card-cta card-cta-wide" href={servicePath('infrastructure-audit')}>
          <span class="card-num">Not sure where you stand?</span>
          <strong>Start with a 5-day Infrastructure Health Check →</strong>
        </a>
      </div>
    </section>

    <section class="container section" id="services" aria-labelledby="services-title">
      <p class="eyebrow">DevOps &amp; SRE consulting packages</p>
      <h2 class="section-title" id="services-title">Clear scope. Clear deliverables. A clear quote before work starts.</h2>
      <p class="section-lead">
        Every engagement starts read-only. Prices in USD; projects are 50% upfront, 50% on delivery.{' '}
        <a href="/services/">See every service in detail →</a>
      </p>

      <div class="featured">
        <div class="featured-main">
          <span class="badge">Start here</span>
          <h3>Infrastructure Health Check</h3>
          <p class="featured-time">5 business days</p>
          <p class="featured-price">From $500</p>
          <p class="featured-note">Depends on the size of your setup.</p>
          <a class="btn btn-primary" href={mailto('Infrastructure Health Check')}>Book the Health Check</a>
          <a class="featured-link" href={servicePath('infrastructure-audit')}>What the audit covers →</a>
        </div>
        <ul class="check-list featured-list">
          {
            [
              'Read-only review of your cloud, CI/CD, security, monitoring and certificates',
              'Risk-scored report with a 30/60/90-day plan',
              '60-minute walkthrough call with your team',
              'Fee credited in full if you book implementation',
            ].map((item) => (
              <li>
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={check} />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid grid-2 grid-tight">
        {
          packages.map((p) => (
            <div class="package">
              <div class="package-head">
                <h3>{p.name}</h3>
                <span class="package-time">{p.time}</span>
              </div>
              <p class="package-price">{p.price}</p>
              <p>{p.body}</p>
              {p.guarantee && <p class="package-guarantee">{p.guarantee}</p>}
              <a class="package-link" href={servicePath(p.slug)}>See details →</a>
            </div>
          ))
        }
      </div>

      <div class="package package-full">
        <div class="package-head">
          <h3>Fractional DevOps Engineer</h3>
          <span class="package-time">monthly · no minimum term</span>
        </div>
        <p class="package-price">$1,000–3,000<span> / month</span></p>
        <p>20–30 hours a week across DevOps, SRE and AI operations, business-hours support and a monthly report. For teams without a full-time DevOps engineer, or waiting for one to start.</p>
        <a class="package-link" href={servicePath('fractional-devops-engineer')}>See details →</a>
      </div>
    </section>

    <section class="container section" id="ai" aria-labelledby="ai-title">
      <p class="eyebrow">AI integration</p>
      <h2 class="section-title" id="ai-title">Put AI to work in your business, at a cost that makes sense.</h2>
      <p class="section-lead">
        I help teams pick the AI use cases worth paying for, automate repetitive work, and run AI features in
        production with the same security and cost discipline I apply to payments infrastructure.
      </p>
      <div class="grid grid-3">
        {
          aiPackages.map((p) => (
            <div class="package">
              <div class="package-head">
                <h3>{p.name}</h3>
                <span class="package-time">{p.time}</span>
              </div>
              <p class="package-price">{p.price}</p>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
      <div class="levers">
        <h3>How I keep your AI bill low</h3>
        <ul class="check-list">
          {
            aiCostLevers.map((item) => (
              <li>
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={check} />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <div class="levers-actions">
          <a class="btn btn-primary" href={mailto('AI Opportunity & Cost Review')}>Book the AI Review</a>
          <a class="featured-link" href={servicePath('ai-integration')}>More on AI integration →</a>
        </div>
      </div>
    </section>

    <section class="container section" id="work" aria-labelledby="work-title">
      <p class="eyebrow">Selected work</p>
      <h2 class="section-title" id="work-title">Production stories from a regulated payments stack.</h2>
      <p class="section-lead">Company and client details are anonymised.</p>
      <div class="grid grid-2">
        {
          cases.map((c) => (
            <article class="case">
              <span class="case-kicker">{c.kicker}</span>
              <h3>{c.title}</h3>
              <dl>
                <dt>Problem</dt>
                <dd>{c.problem}</dd>
                <dt>What I did</dt>
                <dd>{c.did}</dd>
              </dl>
              <div class="tags">
                {c.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="container section" id="process" aria-labelledby="process-title">
      <p class="eyebrow">How I work</p>
      <h2 class="section-title" id="process-title">Four steps, and you own everything at the end.</h2>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <div class="card-num">{String(i + 1).padStart(2, '0')}</div>
              <h3>{s.name}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
      <ul class="safeguards">
        <li>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="12" height="8" rx="2"></rect><path d="M7 9V6.5a3 3 0 0 1 6 0V9"></path></svg>
          <span>Least-privilege roles through your SSO, with MFA</span>
        </li>
        <li>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h6l3 3v11H6z"></path><path d="M9 10h4M9 13h4"></path></svg>
          <span>NDA signed before any access</span>
        </li>
        <li>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h12M4 10h12M4 15h7"></path></svg>
          <span>Every change logged; access revoked at handover</span>
        </li>
        <li>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="6.5"></circle><path d="M7.5 10.5l1.8 1.8 3.4-3.8"></path></svg>
          <span>AI tooling only with no data retention</span>
        </li>
      </ul>
    </section>

    <section class="container section" id="faq" aria-labelledby="faq-title">
      <p class="eyebrow">FAQ</p>
      <h2 class="section-title" id="faq-title">Questions clients ask before we start.</h2>
      <div class="faq">
        {
          faqs.map((f) => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="container section about" id="about" aria-labelledby="about-title">
      <div class="about-body">
        <p class="eyebrow">About</p>
        <h2 class="section-title" id="about-title">Hi, I’m Usama.</h2>
        <p class="about-text">
          I’m a Senior DevOps Engineer in Lahore with 4+ years running production infrastructure, today for a
          payments company where PCI DSS isn’t optional. Alongside that I work with a small number of startups and
          established businesses, so each project gets senior attention.
        </p>
        <p class="about-text">
          My favourite problems are the unglamorous ones: certificates, keys, access and audits, plus the cloud
          bill nobody has looked at in a year. Lately that includes AI: getting it out of the demo and into
          production, safely and at a sensible cost.
        </p>
        <p class="about-meta">
          {aboutMeta.map((item, i) => (i === 0 ? item : item.replace(/ /g, '\u00a0'))).join('\u00a0· ')}
        </p>
      </div>
    </section>
  </main>

  <Contact />
  <Footer />
</Base>
